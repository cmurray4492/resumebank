{{define "base.html.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}</title>
  <meta name="description" content="{{.Description}}">
  <meta property="og:title" content="{{.Title}}">
  <meta property="og:description" content="{{.Description}}">
  <meta property="og:type" content="website">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/site.css">
</head>
<body class="d-flex flex-column min-vh-100">
  {{template "navbar.html.tmpl" .}}

  <main class="container flex-grow-1 py-4">
    {{template "content" .}}
  </main>

  <footer class="border-top py-3 text-center text-muted small">
    <div class="mb-1">
      <a href="/about" class="text-muted me-3">About</a>
      <a href="/terms" class="text-muted">Terms and Conditions</a>
    </div>
    &copy; {{currentYear}} resumebank.biz
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <!-- Quill has no officially published SRI hash for its CDN build, so it's loaded without integrity="". -->
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
  <script src="/static/js/editor.js"></script>
  <script src="/static/js/share.js"></script>
  {{template "scripts" .}}
</body>
</html>
{{end}}
