{{define "base.html.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google-site-verification" content="oZZUFf02XLcXose_F5olvU_lba5h_q8T8csuEtm522U" />
  <title>{{.Title}}</title>
  <meta name="description" content="{{.Description}}">
  <meta property="og:title" content="{{.Title}}">
  <meta property="og:description" content="{{.Description}}">
  <meta property="og:type" content="website">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/site.css">
</head>
<body class="d-flex flex-column min-vh-100">
  {{template "navbar.html.tmpl" .}}

  <main class="container flex-grow-1 py-4">
    {{template "content" .}}
  </main>

  <footer class="border-top py-3 text-center text-muted small">
    <div class="mb-1">
      <a href="/about" class="text-muted me-3">About</a>
      <a href="/terms" class="text-muted me-3">Terms and Conditions</a>
      <a href="/privacy" class="text-muted me-3">Privacy Policy</a>
      <a href="/privacy#do-not-sell" class="text-muted">Do Not Sell/Share My Personal Information</a>
    </div>
    &copy; {{currentYear}} resumebank.biz
  </footer>

  <div id="cookie-notice" class="d-none position-fixed bottom-0 start-0 end-0 bg-dark text-white p-3" style="z-index: 1050;">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
      <span class="small">
        We use strictly-necessary cookies to keep you signed in and to secure this site. We don't use
        tracking or advertising cookies. See our <a href="/privacy#cookies" class="text-white text-decoration-underline">Privacy Policy</a> for details.
      </span>
      <button type="button" id="cookie-notice-dismiss" class="btn btn-sm btn-light flex-shrink-0">Got it</button>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <!-- Quill has no officially published SRI hash for its CDN build, so it's loaded without integrity="". -->
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
  <script src="/static/js/editor.js"></script>
  <script src="/static/js/share.js"></script>
  <script src="/static/js/cookie-notice.js"></script>
  {{template "scripts" .}}
</body>
</html>
{{end}}
