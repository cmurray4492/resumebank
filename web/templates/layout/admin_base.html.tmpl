{{define "admin_base.html.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} &mdash; Admin</title>
  <meta name="robots" content="noindex, nofollow">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/site.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
  {{if .AdminUser}}
    <nav class="navbar navbar-expand-md navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/admin">resumebank.biz Admin</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavMenu">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="adminNavMenu">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><a class="nav-link" href="/admin/blog">Blog</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/candidates">Candidates</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/employers">Companies</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/jobs">Jobs</a></li>
          </ul>
          <span class="navbar-text text-light me-3">{{.AdminUser.Email}}</span>
          <form action="/admin/logout" method="post" class="d-inline">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <button type="submit" class="btn btn-outline-light btn-sm">Log Out</button>
          </form>
        </div>
      </div>
    </nav>
  {{end}}

  <main class="container flex-grow-1 py-4">
    {{template "content" .}}
  </main>

  <footer class="border-top py-3 text-center text-muted small bg-white">
    resumebank.biz Admin Panel
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
  <script src="/static/js/editor.js"></script>
  {{template "scripts" .}}
</body>
</html>
{{end}}
