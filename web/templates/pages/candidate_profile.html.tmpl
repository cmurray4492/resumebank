{{define "content"}}
{{$c := .Data.Candidate}}
<article>
  <header class="d-flex justify-content-between align-items-start mb-3">
    <div class="d-flex align-items-center gap-3">
      {{if $c.PhotoPath}}
        <img src="/candidates/{{$c.Slug}}/photo" alt="{{$c.Name}}" class="rounded-circle" style="width: 96px; height: 96px; object-fit: cover;">
      {{end}}
      <div>
        <h1>{{$c.Name}}</h1>
        {{if $c.Title}}<p class="lead text-muted">{{$c.Title}}</p>{{end}}
      </div>
    </div>
    {{if .Data.IsOwner}}
      <a class="btn btn-outline-primary" href="/candidates/{{$c.Slug}}/edit">Edit Profile</a>
    {{else if and .CurrentUser (eq (printf "%v" .CurrentUser.Role) "employer")}}
      <a class="btn btn-outline-primary" href="/messages/{{$c.UserID}}">Message {{$c.Name}}</a>
    {{end}}
  </header>

  <dl class="row">
    {{if $c.City}}<dt class="col-sm-2">Location</dt><dd class="col-sm-10">{{$c.City}}{{if $c.State}}, {{$c.State}}{{end}} {{$c.Zipcode}}</dd>{{end}}
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">{{$c.Email}}</dd>
    {{if $c.Phone}}<dt class="col-sm-2">Phone</dt><dd class="col-sm-10">{{$c.Phone}}</dd>{{end}}
    {{if $c.LinkedInURL}}<dt class="col-sm-2">LinkedIn</dt><dd class="col-sm-10"><a href="{{$c.LinkedInURL}}" target="_blank" rel="noopener noreferrer">{{$c.LinkedInURL}}</a></dd>{{end}}
    {{if $c.Skills}}<dt class="col-sm-2">Skills</dt><dd class="col-sm-10">{{$c.Skills}}</dd>{{end}}
  </dl>

  {{if $c.Summary}}
    <h2 class="h5">Summary</h2>
    <p>{{$c.Summary}}</p>
  {{end}}

  <h2 class="h5">Resume</h2>
  <div class="rich-text border rounded p-3 bg-white">{{safeHTML $c.ResumeHTML}}</div>

  <h2 class="h5 mt-4">Files</h2>
  {{if .Data.Files}}
    <ul class="list-group mb-3" style="max-width: 400px;">
      {{range .Data.Files}}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <a href="/files/{{.ID}}/download" target="_blank" rel="noopener">
            {{if eq (printf "%v" .Kind) "resume_pdf"}}Resume (PDF){{else}}{{.OriginalFilename}}{{end}}
          </a>
          {{if $.Data.IsOwner}}
            <form action="/candidates/{{$c.Slug}}/files/{{.ID}}/delete" method="post" class="d-inline">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
            </form>
          {{end}}
        </li>
      {{end}}
    </ul>
  {{else}}
    <p class="text-muted">No files uploaded yet.</p>
  {{end}}

  {{if and .Data.IsOwner .Data.RecommendedJobs}}
    <h2 class="h5 mt-4">Recommended Jobs For You</h2>
    <div class="alert alert-warning small">
      This feature is in development. Results are based on semantic similarity between your resume
      and job descriptions, computed by a local AI model &mdash; they're suggestions, not guarantees.
      Only visible to you.
    </div>
    <ul class="list-group mb-3" style="max-width: 700px;">
      {{range .Data.RecommendedJobs}}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <div>
              <a href="/jobs/{{.Slug}}">{{.Title}}</a>
              <span class="text-muted"> at <a href="/employers/{{.EmployerSlug}}">{{.CompanyName}}</a>{{if .Location}} &mdash; {{.Location}}{{end}}</span>
            </div>
            {{if .MatchedSkills}}
              <div class="mt-1">
                <span class="text-muted small">Matched on:</span>
                {{range .MatchedSkills}}<span class="badge bg-light text-dark border me-1">{{.}}</span>{{end}}
              </div>
            {{end}}
          </div>
          <span class="badge bg-primary rounded-pill">{{matchPercent .Similarity}}</span>
        </li>
      {{end}}
    </ul>
  {{end}}
</article>
{{end}}

{{define "scripts"}}{{end}}
