{{define "content"}}
<div class="row justify-content-center">
  <div class="col-md-8">
    <h1 class="h3 mb-4">Create a Candidate Account</h1>
    <form method="post" action="/signup/candidate" novalidate>
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

      <div class="row">
        <div class="mb-3 col-md-6">
          <label class="form-label" for="email">Email *</label>
          <input type="email" class="form-control {{if index .Errors "email"}}is-invalid{{end}}" id="email" name="email" required>
          {{with index .Errors "email"}}<div class="invalid-feedback d-block">{{.}}</div>{{end}}
        </div>
        <div class="mb-3 col-md-6">
          <label class="form-label" for="password">Password *</label>
          <input type="password" class="form-control {{if index .Errors "password"}}is-invalid{{end}}" id="password" name="password" required>
          {{with index .Errors "password"}}<div class="invalid-feedback d-block">{{.}}</div>{{end}}
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="name">Name *</label>
        <input type="text" class="form-control {{if index .Errors "name"}}is-invalid{{end}}" id="name" name="name" required>
        {{with index .Errors "name"}}<div class="invalid-feedback d-block">{{.}}</div>{{end}}
      </div>

      <div class="mb-3">
        <label class="form-label" for="title">Title</label>
        <input type="text" class="form-control" id="title" name="title">
        <div class="form-text">The title you want prospective employers to see.</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label class="form-label" for="city">City</label>
          <input type="text" class="form-control" id="city" name="city">
        </div>
        <div class="mb-3 col-md-4">
          <label class="form-label" for="state">State</label>
          <input type="text" class="form-control" id="state" name="state">
        </div>
        <div class="mb-3 col-md-4">
          <label class="form-label" for="zipcode">Zipcode *</label>
          <input type="text" class="form-control {{if index .Errors "zipcode"}}is-invalid{{end}}" id="zipcode" name="zipcode" required>
          {{with index .Errors "zipcode"}}<div class="invalid-feedback d-block">{{.}}</div>{{end}}
        </div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-6">
          <label class="form-label" for="phone">Phone</label>
          <input type="tel" class="form-control" id="phone" name="phone">
        </div>
        <div class="mb-3 col-md-6">
          <label class="form-label" for="linkedin_url">LinkedIn URL</label>
          <input type="url" class="form-control" id="linkedin_url" name="linkedin_url">
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="skills">Skills</label>
        <input type="text" class="form-control" id="skills" name="skills">
        <div class="form-text">Enter skills and keywords you want indexed with your profile.</div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="summary">Candidate Summary</label>
        <textarea class="form-control" id="summary" name="summary" rows="3"></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Resume *</label>
        <div id="resume-editor" style="height: 250px;"></div>
        <textarea name="resume_html" id="resume_html" hidden></textarea>
        {{with index .Errors "resume_html"}}<div class="invalid-feedback d-block">{{.}}</div>{{end}}
      </div>

      <button type="submit" class="btn btn-primary">Create Account</button>
    </form>
  </div>
</div>
{{end}}

{{define "scripts"}}
<script>
  initRichTextEditor('resume-editor', 'resume_html');
</script>
{{end}}
