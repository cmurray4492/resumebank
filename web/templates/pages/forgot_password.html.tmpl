{{define "content"}}
<div class="row justify-content-center">
  <div class="col-md-5">
    <h1 class="h3 mb-4">Forgot Password</h1>

    {{if .Data.Submitted}}
      <div class="alert alert-success">
        If an account exists for that email address, we've sent a link to reset your password.
        It expires in 1 hour.
      </div>
      <p><a href="/login">Back to Log In</a></p>
    {{else}}
      <p class="text-muted">Enter your account email and we'll send you a link to reset your password.</p>
      <form method="post" action="/forgot-password" novalidate>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <div class="mb-3">
          <label class="form-label" for="email">Email</label>
          <input type="email" class="form-control {{if index .Errors "email"}}is-invalid{{end}}" id="email" name="email" value="{{.Data.Email}}" required>
          {{with index .Errors "email"}}<div class="invalid-feedback d-block">{{.}}</div>{{end}}
        </div>
        <button type="submit" class="btn btn-primary">Send Reset Link</button>
      </form>
    {{end}}
  </div>
</div>
{{end}}

{{define "scripts"}}{{end}}
