{{define "content"}}
<h1 class="h3 mb-4">Blog</h1>

{{if .Data.Posts}}
  <div class="row g-4">
    {{range .Data.Posts}}
      <div class="col-md-6">
        <article class="card h-100">
          <div class="card-body">
            <h2 class="h5 card-title"><a href="/blog/{{.Slug}}" class="text-decoration-none">{{.Title}}</a></h2>
            <p class="card-text text-muted small">
              {{if .PublishedAt}}{{formatDateP .PublishedAt}}{{end}}
              {{if .AuthorName}} &middot; {{.AuthorName}}{{end}}
            </p>
            <p class="card-text">{{.Excerpt}}</p>
            <a href="/blog/{{.Slug}}">Read more &rarr;</a>
          </div>
        </article>
      </div>
    {{end}}
  </div>
{{else}}
  <p class="text-muted">No posts yet &mdash; check back soon.</p>
{{end}}

<nav class="mt-4">
  <ul class="pagination">
    {{if .Data.HasPrevPage}}<li class="page-item"><a class="page-link" href="/blog?page={{.Data.PrevPage}}">Previous</a></li>{{end}}
    {{if .Data.HasNextPage}}<li class="page-item"><a class="page-link" href="/blog?page={{.Data.NextPage}}">Next</a></li>{{end}}
  </ul>
</nav>
{{end}}

{{define "scripts"}}{{end}}
