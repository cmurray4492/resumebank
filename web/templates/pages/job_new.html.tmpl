{{define "content"}}
{{$e := .Data}}
<div class="row justify-content-center">
  <div class="col-md-8">
    <h1 class="h3 mb-4">Post a Job at {{$e.CompanyName}}</h1>
    <form method="post" action="/employers/{{$e.Slug}}/jobs" novalidate>
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

      <div class="mb-3">
        <label class="form-label" for="title">Title *</label>
        <input type="text" class="form-control {{if index .Errors "title"}}is-invalid{{end}}" id="title" name="title" required>
        {{with index .Errors "title"}}<div class="invalid-feedback d-block">{{.}}</div>{{end}}
      </div>

      <div class="row">
        <div class="mb-3 col-md-6">
          <label class="form-label" for="location">Location</label>
          <input type="text" class="form-control" id="location" name="location">
        </div>
        <div class="mb-3 col-md-6">
          <label class="form-label" for="job_number">Job Number</label>
          <input type="text" class="form-control" id="job_number" name="job_number">
        </div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-6">
          <label class="form-label" for="salary_min">Salary Min</label>
          <input type="number" class="form-control" id="salary_min" name="salary_min" min="0">
        </div>
        <div class="mb-3 col-md-6">
          <label class="form-label" for="salary_max">Salary Max</label>
          <input type="number" class="form-control" id="salary_max" name="salary_max" min="0">
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Description *</label>
        <div id="job-description-editor" style="height: 250px;"></div>
        <textarea name="description_html" id="description_html" hidden></textarea>
        {{with index .Errors "description_html"}}<div class="invalid-feedback d-block">{{.}}</div>{{end}}
      </div>

      <button type="submit" class="btn btn-primary">Post Job</button>
    </form>
  </div>
</div>
{{end}}

{{define "scripts"}}
<script>
  initRichTextEditor('job-description-editor', 'description_html');
</script>
{{end}}
