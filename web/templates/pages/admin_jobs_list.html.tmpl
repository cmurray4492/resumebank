{{define "content"}}
<h1 class="h3 mb-4">Jobs</h1>

{{if .Data.Jobs}}
  <table class="table bg-white">
    <thead><tr><th>Title</th><th>Company</th><th>Location</th><th></th></tr></thead>
    <tbody>
      {{range .Data.Jobs}}
        <tr>
          <td>{{.Job.Title}}</td>
          <td>{{.CompanyName}}</td>
          <td>{{.Job.Location}}</td>
          <td class="text-end">
            <a href="/jobs/{{.Job.Slug}}" class="me-2" target="_blank" rel="noopener">View</a>
            <a href="/admin/jobs/{{.Job.ID}}/edit">Edit</a>
          </td>
        </tr>
      {{end}}
    </tbody>
  </table>
{{else}}
  <p class="text-muted">No jobs yet.</p>
{{end}}

<nav>
  <ul class="pagination">
    {{if .Data.HasPrevPage}}<li class="page-item"><a class="page-link" href="/admin/jobs?page={{.Data.PrevPage}}">Previous</a></li>{{end}}
    {{if .Data.HasNextPage}}<li class="page-item"><a class="page-link" href="/admin/jobs?page={{.Data.NextPage}}">Next</a></li>{{end}}
  </ul>
</nav>
{{end}}

{{define "scripts"}}{{end}}
