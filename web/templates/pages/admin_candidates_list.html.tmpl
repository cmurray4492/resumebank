{{define "content"}}
<h1 class="h3 mb-4">Candidates</h1>

{{if .Data.Candidates}}
  <table class="table bg-white">
    <thead><tr><th>Name</th><th>Title</th><th>Email</th><th></th></tr></thead>
    <tbody>
      {{range .Data.Candidates}}
        <tr>
          <td>{{.Candidate.Name}}</td>
          <td>{{.Candidate.Title}}</td>
          <td>{{.Candidate.Email}}</td>
          <td class="text-end">
            <a href="/candidates/{{.Candidate.Slug}}" class="me-2" target="_blank" rel="noopener">View</a>
            <a href="/admin/candidates/{{.Candidate.ID}}/edit">Edit</a>
            <form method="post" action="/admin/candidates/{{.Candidate.ID}}/delete" class="d-inline ms-2" onsubmit="return confirm('Permanently delete this candidate, including their account, files and messages? This cannot be undone.');">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <button type="submit" class="btn btn-link btn-sm text-danger p-0 align-baseline">Delete</button>
            </form>
          </td>
        </tr>
      {{end}}
    </tbody>
  </table>
{{else}}
  <p class="text-muted">No candidates yet.</p>
{{end}}

<nav>
  <ul class="pagination">
    {{if .Data.HasPrevPage}}<li class="page-item"><a class="page-link" href="/admin/candidates?page={{.Data.PrevPage}}">Previous</a></li>{{end}}
    {{if .Data.HasNextPage}}<li class="page-item"><a class="page-link" href="/admin/candidates?page={{.Data.NextPage}}">Next</a></li>{{end}}
  </ul>
</nav>
{{end}}

{{define "scripts"}}{{end}}
