{{define "content"}}
{{$post := .Data.Post}}
<h1 class="h3 mb-4">{{if $post}}Edit Blog Post{{else}}New Blog Post{{end}}</h1>

<form method="post" action="{{if $post}}/admin/blog/{{$post.ID}}/edit{{else}}/admin/blog{{end}}" novalidate style="max-width: 800px;">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

  <div class="mb-3">
    <label class="form-label" for="title">Title *</label>
    <input type="text" class="form-control {{if index .Errors "title"}}is-invalid{{end}}" id="title" name="title"
      value="{{if $post}}{{$post.Title}}{{end}}" required>
    {{with index .Errors "title"}}<div class="invalid-feedback d-block">{{.}}</div>{{end}}
  </div>

  <div class="mb-3">
    <label class="form-label" for="author_name">Author Name</label>
    <input type="text" class="form-control" id="author_name" name="author_name" value="{{if $post}}{{$post.AuthorName}}{{end}}">
  </div>

  <div class="mb-3">
    <label class="form-label">Body *</label>
    <div id="body-editor" style="height: 300px;"></div>
    <textarea name="body_html" id="body_html" hidden>{{if $post}}{{$post.BodyHTML}}{{end}}</textarea>
    {{with index .Errors "body_html"}}<div class="invalid-feedback d-block">{{.}}</div>{{end}}
  </div>

  <div class="mb-3 form-check">
    <input type="checkbox" class="form-check-input" id="published" name="published" {{if and $post $post.Published}}checked{{end}}>
    <label class="form-check-label" for="published">Published (visible on the public blog)</label>
  </div>

  <button type="submit" class="btn btn-primary">{{if $post}}Save Changes{{else}}Create Post{{end}}</button>
</form>

{{if $post}}
  <form action="/admin/blog/{{$post.ID}}/delete" method="post" class="mt-3"
        onsubmit="return confirm('Delete this post permanently?');">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <button type="submit" class="btn btn-outline-danger btn-sm">Delete Post</button>
  </form>
{{end}}
{{end}}

{{define "scripts"}}
<script>
  initRichTextEditor('body-editor', 'body_html');
</script>
{{end}}
