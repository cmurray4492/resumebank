{{define "content"}}
{{$post := .Data}}
<article style="max-width: 800px;">
  <p class="mb-2"><a href="/blog">&larr; Back to Blog</a></p>
  <h1 class="mb-1">{{$post.Title}}</h1>
  <p class="text-muted">
    {{if $post.PublishedAt}}{{formatDateP $post.PublishedAt}}{{end}}
    {{if $post.AuthorName}} &middot; {{$post.AuthorName}}{{end}}
  </p>
  <div class="mt-4">{{safeHTML $post.BodyHTML}}</div>
</article>
{{end}}

{{define "scripts"}}{{end}}
