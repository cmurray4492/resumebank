{{define "content"}}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Blog Posts</h1>
  <a href="/admin/blog/new" class="btn btn-primary">New Post</a>
</div>

{{if .Data.Posts}}
  <table class="table bg-white">
    <thead><tr><th>Title</th><th>Status</th><th>Updated</th><th></th></tr></thead>
    <tbody>
      {{range .Data.Posts}}
        <tr>
          <td>{{.Title}}</td>
          <td>{{if .Published}}<span class="badge bg-success">Published</span>{{else}}<span class="badge bg-secondary">Draft</span>{{end}}</td>
          <td>{{formatDate .UpdatedAt}}</td>
          <td class="text-end">
            {{if .Published}}<a href="/blog/{{.Slug}}" class="me-2" target="_blank" rel="noopener">View</a>{{end}}
            <a href="/admin/blog/{{.ID}}/edit">Edit</a>
          </td>
        </tr>
      {{end}}
    </tbody>
  </table>
{{else}}
  <p class="text-muted">No blog posts yet.</p>
{{end}}

<nav>
  <ul class="pagination">
    {{if .Data.HasPrevPage}}<li class="page-item"><a class="page-link" href="/admin/blog?page={{.Data.PrevPage}}">Previous</a></li>{{end}}
    {{if .Data.HasNextPage}}<li class="page-item"><a class="page-link" href="/admin/blog?page={{.Data.NextPage}}">Next</a></li>{{end}}
  </ul>
</nav>
{{end}}

{{define "scripts"}}{{end}}
