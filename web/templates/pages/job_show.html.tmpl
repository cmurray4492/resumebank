{{define "content"}}
{{$j := .Data.Job}}
<article>
  <header class="d-flex justify-content-between align-items-start mb-3">
    <div class="d-flex align-items-center gap-3">
      {{if .Data.EmployerHasLogo}}
        <img src="/employers/{{.Data.EmployerSlug}}/logo" alt="{{.Data.CompanyName}} logo" style="width: 64px; height: 64px; object-fit: contain;">
      {{end}}
      <div>
        <h1>{{$j.Title}}</h1>
        <p class="lead text-muted">
          <a href="/employers/{{.Data.EmployerSlug}}">{{.Data.CompanyName}}</a>
          {{if $j.Location}} &mdash; {{$j.Location}}{{end}}
        </p>
      </div>
    </div>
    {{if .Data.IsOwner}}
      <div>
        <a class="btn btn-outline-primary me-2" href="/jobs/{{$j.Slug}}/edit">Edit</a>
        <form action="/jobs/{{$j.Slug}}/delete" method="post" class="d-inline">
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <button type="submit" class="btn btn-outline-danger">Delete</button>
        </form>
      </div>
    {{end}}
  </header>

  <dl class="row">
    <dt class="col-sm-2">Posted</dt><dd class="col-sm-10">{{formatDate $j.DatePosted}}</dd>
    {{if $j.JobNumber}}<dt class="col-sm-2">Job Number</dt><dd class="col-sm-10">{{$j.JobNumber}}</dd>{{end}}
    <dt class="col-sm-2">Salary</dt><dd class="col-sm-10">{{formatSalary $j.SalaryMin $j.SalaryMax}}</dd>
  </dl>

  {{if $j.ApplyValue}}
    <div class="mb-4">
      {{if eq $j.ApplyMethod "email"}}
        <a class="btn btn-primary" href="mailto:{{$j.ApplyValue}}">Apply via Email</a>
      {{else}}
        <a class="btn btn-primary" href="{{$j.ApplyValue}}" target="_blank" rel="noopener noreferrer">Apply Now</a>
      {{end}}
    </div>
  {{end}}

  <h2 class="h5">Description</h2>
  <div class="rich-text border rounded p-3 bg-white mb-4">{{safeHTML $j.DescriptionHTML}}</div>

  <div class="d-flex align-items-center gap-3">
    {{if .Data.CanVote}}
      <form action="/jobs/{{$j.Slug}}/vote" method="post" class="d-inline">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="direction" value="up">
        <button type="submit" class="btn {{if eq .Data.CurrentVote 1}}btn-success{{else}}btn-outline-success{{end}} btn-sm">
          &#128077; {{.Data.UpVotes}}
        </button>
      </form>
      <form action="/jobs/{{$j.Slug}}/vote" method="post" class="d-inline">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="direction" value="down">
        <button type="submit" class="btn {{if eq .Data.CurrentVote -1}}btn-danger{{else}}btn-outline-danger{{end}} btn-sm">
          &#128078; {{.Data.DownVotes}}
        </button>
      </form>
    {{else}}
      <span class="text-muted">&#128077; {{.Data.UpVotes}} &nbsp; &#128078; {{.Data.DownVotes}}</span>
    {{end}}
  </div>

  <div class="mt-4 pt-3 border-top">{{template "share_buttons.html.tmpl" .}}</div>
</article>
{{end}}

{{define "scripts"}}{{end}}
